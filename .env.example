# ==================================================
# ENVIRONMENT CONFIGURATION
# ==================================================
# Environment: development, test, or production
# REQUIRED: Must be set explicitly in production
NODE_ENV=development

# ==================================================
# API SERVER (NestJS)
# ==================================================
# HTTP port for API server
# REQUIRED: Valid TCP port 1-65535
PORT=4000

# ==================================================
# DATABASE (PostgreSQL)
# ==================================================
# PostgreSQL connection string
# Format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
# REQUIRED in production
# For production:
#   - Use strong credentials
#   - Enable SSL: ?sslmode=require
#   - Specify schema: ?schema=public
DATABASE_URL=postgresql://queue_user:queue_password@localhost:5432/queue_management?schema=public

# ==================================================
# CACHE / MESSAGE QUEUE (Redis)
# ==================================================
# Redis is currently DEFERRED in the Free-Tier architecture.
# REDIS_URL=redis://localhost:6379

# ==================================================
# AUTHENTICATION (JWT)
# ==================================================
# JWT Access Token Secret
# REQUIRED in production
# Must be:
#   - At least 32 characters
#   - Randomly generated
#   - Environment-specific
#   - NOT a placeholder value
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret

# JWT Refresh Token Secret
# REQUIRED in production
# Must be:
#   - At least 32 characters
#   - Randomly generated
#   - Environment-specific
#   - NOT a placeholder value
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# ==================================================
# TIMEZONE CONFIGURATION
# ==================================================
# IANA timezone for token time calculations
# REQUIRED: Valid timezone identifier
# Examples: Asia/Kolkata, America/New_York, Europe/London, UTC
TOKEN_TIME_ZONE=Asia/Kolkata

# ==================================================
# CORS (Cross-Origin Resource Sharing)
# ==================================================
# Comma-separated list of allowed origins
# Used by API to validate cross-origin requests
# REQUIRED in production
# Examples:
#   Single origin: https://app.example.com
#   Multiple origins: https://app.example.com,https://admin.example.com
# Credentials flag is enabled; only specific origins allowed
CORS_ORIGIN=http://localhost:3000

# ==================================================
# NOTIFICATIONS
# ==================================================
# Notification provider: noop, mock, or real provider
# noop: No-op provider, useful for development
# mock: Mock provider for testing
# REQUIRED: Must be explicitly set
NOTIFICATION_PROVIDER=noop

# ==================================================
# WEB APP (Next.js)
# ==================================================
# API URL used by Next.js web app rewrites
# Must be accessible from browser and server
# If not set, defaults to http://localhost:4000
# For production: Use public HTTPS URL
API_URL=http://localhost:4000

# ==================================================
# SEED USER (prisma/seed.ts)
# ==================================================
# Credentials for the dummy admin user created by `npx prisma db seed`.
# REQUIRED: Both email and password must be set.
# Password must be at least 8 characters.
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=ChangeMe123!
SEED_USER_NAME=Admin User

# ==================================================
# OPTIONAL / FUTURE CONFIGURATION
# ==================================================
# Placeholder for future service integrations
# SMS/WhatsApp provider credentials (when configured)
# External API keys
# Cloud service credentials
